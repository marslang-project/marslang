fixed hot pi (float) = 3.14159;

func area(float r;) => pi * r * r;

family Circle{
    func init(float r;){
        me.r = r;
    }

    func size(){
        ret area(me.r);
    }
}

func m{
    nums (array[int]) = a(3,1,4,1,5);
    nums.asort();
    out(nums.iget(0));

    c = Circle(5);
    out(c.size());
}
