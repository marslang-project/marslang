// std.containers: stack, queue, deque, and priority queue, written in Marslang.
// Empty containers return null from pop and peek, like built-in arrays.
takepkg std.Decorator;

// Last in, first out.
family stack{
    func init(){ me._items = arr(); }
    func push(any item){ me._items.add(item); ret me; }
    func pop(){ ret me._items.lpop(); }
    func peek(){
        if (me._items.is_empty()){ ret null; }
        ret me._items.iget(me._items.len() - 1);
    }
    func len => me._items.len();
    func is_empty => me._items.is_empty();
    // Items from bottom to top.
    func items => me._items.slice(0, me._items.len());
}

// Double-ended queue on a ring buffer: adding or removing at either end does not
// move the other items.
family deque{
    func init(){
        me._ring = arr(null, null, null, null, null, null, null, null);
        me._head = 0;
        me._count = 0;
    }
    @Decorator.private
    func _slot(int offset) => (me._head + offset) % me._ring.len();
    @Decorator.private
    func _grow(){
        if (me._count < me._ring.len()){ ret null; }
        bigger = arr();
        for (i=0, i<me._count, i++){ bigger.add(me._ring.iget(me._slot(i))); }
        repeat me._count { bigger.add(null); }
        me._ring = bigger;
        me._head = 0;
    }
    func push_back(any item){
        me._grow();
        me._ring.modify(me._slot(me._count), item);
        me._count = me._count + 1;
        ret me;
    }
    func push_front(any item){
        me._grow();
        me._head = (me._head - 1 + me._ring.len()) % me._ring.len();
        me._ring.modify(me._head, item);
        me._count = me._count + 1;
        ret me;
    }
    func pop_front(){
        if (me._count == 0){ ret null; }
        item = me._ring.iget(me._head);
        me._ring.modify(me._head, null);
        me._head = me._slot(1);
        me._count = me._count - 1;
        ret item;
    }
    func pop_back(){
        if (me._count == 0){ ret null; }
        last = me._slot(me._count - 1);
        item = me._ring.iget(last);
        me._ring.modify(last, null);
        me._count = me._count - 1;
        ret item;
    }
    func peek_front(){
        if (me._count == 0){ ret null; }
        ret me._ring.iget(me._head);
    }
    func peek_back(){
        if (me._count == 0){ ret null; }
        ret me._ring.iget(me._slot(me._count - 1));
    }
    func len => me._count;
    func is_empty => me._count == 0;
    // Items from front to back.
    func items(){
        result = arr();
        for (i=0, i<me._count, i++){ result.add(me._ring.iget(me._slot(i))); }
        ret result;
    }
}

// First in, first out.
family queue{
    func init(){ me._items = deque(); }
    func push(any item){ me._items.push_back(item); ret me; }
    func pop() => me._items.pop_front();
    func peek() => me._items.peek_front();
    func len => me._items.len();
    func is_empty => me._items.is_empty();
    // Items from front to back.
    func items => me._items.items();
}

// Binary min-heap keyed by priority: the lowest priority number comes out first;
// equal priorities come out in the order they were pushed.
family priority_queue{
    func init(){
        me._heap = arr();
        me._pushed = 0;
    }
    // Entries are pair(pair(priority, order), item).
    @Decorator.private
    func _before(int a, int b){
        x = me._heap.iget(a).first;
        y = me._heap.iget(b).first;
        if (x.first != y.first){ ret x.first < y.first; }
        ret x.second < y.second;
    }
    @Decorator.private
    func _swap(int a, int b){
        held = me._heap.iget(a);
        me._heap.modify(a, me._heap.iget(b));
        me._heap.modify(b, held);
    }
    func push(any item, [int,longint,float] priority){
        me._heap.add(pair(pair(priority, me._pushed), item));
        me._pushed = me._pushed + 1;
        child = me._heap.len() - 1;
        while (child > 0){
            parent = (child - 1 - (child - 1) % 2) / 2;
            if (not me._before(child, parent)){ break; }
            me._swap(child, parent);
            child = parent;
        }
        ret me;
    }
    func pop(){
        if (me._heap.is_empty()){ ret null; }
        top = me._heap.iget(0).second;
        last = me._heap.lpop();
        if (not me._heap.is_empty()){
            me._heap.modify(0, last);
            at = 0;
            size = me._heap.len();
            while (true){
                smallest = at;
                left = 2 * at + 1;
                right = left + 1;
                if (left < size and me._before(left, smallest)){ smallest = left; }
                if (right < size and me._before(right, smallest)){ smallest = right; }
                if (smallest == at){ break; }
                me._swap(at, smallest);
                at = smallest;
            }
        }
        ret top;
    }
    func peek(){
        if (me._heap.is_empty()){ ret null; }
        ret me._heap.iget(0).second;
    }
    func len => me._heap.len();
    func is_empty => me._heap.is_empty();
    // Items in the order pop would return them; the queue is unchanged.
    func items(){
        drain = priority_queue();
        drain._heap = me._heap.slice(0, me._heap.len());
        result = arr();
        while (not drain.is_empty()){ result.add(drain.pop()); }
        ret result;
    }
}
