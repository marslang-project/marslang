// std.types: inspect values at runtime.
takepkg rs.core;
takepkg std.Decorator;

@Decorator.docstring("The kind of a value as a string: \"int\", \"longint\", \"float\", \"bigint\", \"string\", \"bool\", \"null\", \"array\", \"set\", \"map\", \"pair\", \"instance\", \"function\", \"package\", \"date\", \"datetime\", or \"duration\".")
func kind(any value) => core.kind(value);

@Decorator.docstring("The family name of an instance, or of a family itself, such as \"RangeError\"; null for any other value.")
func family_name(any value) => core.family_name(value);

@Decorator.docstring("Whether value is an instance of family, or of a family inheriting from it.")
func is_instance(any value, any family) => core.is_instance(value, family);

@Decorator.docstring("Whether value is an int, longint, float, or bigint.")
func is_number(any value){
    k = core.kind(value);
    ret k == "int" or k == "longint" or k == "float" or k == "bigint";
}
