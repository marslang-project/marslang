// std.time: clocks and sleeping. Times are float seconds.
takepkg rs.time = native;

// Seconds since 1970-01-01 UTC, from the system clock (can jump if it is changed).
func now() => native.now();

// Seconds from a fixed starting point; never goes backwards. Use it to measure
// elapsed time: end - start.
func monotonic() => native.monotonic();

// Pause the program for a finite, nonnegative number of seconds.
func sleep([int,longint,float] seconds){ native.sleep(float(seconds)); }
