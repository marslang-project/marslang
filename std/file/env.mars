// std.file.env: .env files of KEY=value lines. Reading and writing the text are native
// (std/rs/config.rs); files go through std.file, so writes are all or nothing.
takepkg rs.config = native;
takepkg std.Decorator;
takepkg std.file;

@Decorator.docstring("""
    The KEY=value lines of .env text, as a map from name to value.

        settings = env.parse('PORT=8080\\nNAME="My App"  # shown in the title\\n');
        out(settings.get("PORT"), settings.get("NAME"));   // 8080 My App

    Blank lines and # comments are skipped, and export before a key is allowed.
    A double-quoted value may span lines and takes \\n, \\t, \\", and \\\\
    escapes; a single-quoted one is taken exactly; an unquoted one ends at a #
    after a space. Every value is a string, and $NAME is not expanded. A key
    given twice keeps its first position and its last value.
""")
func parse(string text) => native.env_parse(text, "");

@Decorator.docstring("Read a .env file into a map from name to value, as parse does. Mistakes raise SyntaxError naming the file and line.")
func read(string path) => native.env_parse(file.read(path), path);

@Decorator.docstring("""
    A map as .env text, one KEY=value line each. A value that is not a plain
    word is single-quoted, which every reader takes exactly, or double-quoted
    with escapes when it holds a single quote or a line break, so it reads back
    the same. Keys must be names: letters, digits, and _, not starting with a
    digit.
""")
func format(map values) => native.env_format(values);

@Decorator.docstring("Write values to a file, as format writes them. All or nothing, like file.write. Returns null.")
func write(string path, map values) => file.write(path, native.env_format(values));
