// std.secrets: random bytes fit for passwords, keys, and tokens.
//
// The bytes come from the operating system's cryptographically secure source,
// through the one native function, bytes (std/rs/secrets.rs). Everything else is
// Marslang, below: hex and URL-safe tokens, whole numbers with no bias, choices,
// passwords, and the constant-time comparison, which is std.hash's same.
//
// Use this for anything an attacker must not guess. For simulations, games, and
// test data, use std.random: it is faster and can repeat its numbers from a seed,
// which is exactly what makes it unsafe for secrets.
takepkg rs.secrets = native;
takepkg std.Decorator;
takepkg std.encoding;
takepkg std.hash;
takepkg std.strings;
takepkg std.types;

_DIGITS = "0123456789abcdef";
_LOWER = "abcdefghijklmnopqrstuvwxyz";
_UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
_NUMBERS = "0123456789";
_SYMBOLS = "!@#$%^&*-_=+";

@Decorator.docstring("""
    n random bytes, each an int from 0 to 255, from the operating system's
    secure random source. n is from 0 to 65536; any other count raises
    RangeError.

        key = secrets.bytes(32);   // 32 ints, each from 0 to 255
""")
func bytes([int,longint] n) => _draw("secrets.bytes", n);

@Decorator.docstring("""
    n random bytes as 2n lowercase hex digits: a key or token you can show as
    text, copy, or store. n is from 0 to 65536.

        token = secrets.token_hex(16);   // 32 hex digits, such as "9f0b3c...e1"
""")
func token_hex([int,longint] n) => _hex(_draw("secrets.token_hex", n));

@Decorator.docstring("""
    n random bytes as URL-safe base64: - and _ in place of + and /, with no
    = padding. The result is ceil(4n / 3) characters, and fits in a URL.

        reset = secrets.token_url(24);   // 32 characters from A-Z, a-z, 0-9, - and _
""")
func token_url([int,longint] n){
    text = encoding.base64_bytes(_draw("secrets.token_url", n));
    ret strings.replace(strings.replace(strings.replace(text, "+", "-"), "/", "_"), "=", "");
}

@Decorator.docstring("""
    A whole number from 0 up to, but not, count, every value equally likely:
    no bias, unlike a random number taken modulo count. Random bytes are drawn
    and any above the largest multiple of count are thrown away.

        die = secrets.int_below(6);   // 0, 1, 2, 3, 4, or 5

    An int when count is an int, otherwise a longint. A count of 0 or less
    raises RangeError.
""")
func int_below([int,longint] count){
    if (count <= 0){ err(RangeError, "secrets.int_below needs a count above 0, got " + string(count)); }
    n = bigint(count);
    // The fewest bytes whose values reach n: width bytes give 256 to the power width values.
    width = 1;
    space = bigint(256);
    while (space < n){
        space = space * 256;
        width = width + 1;
    }
    // The values from limit up, where limit is the largest multiple of n not
    // above space, are thrown away. Each of the n remainders then has exactly
    // limit / n values among those kept, so none is favoured.
    limit = space - space % n;
    value = limit;
    while (value >= limit){ value = _number(_draw("secrets.int_below", width)); }
    result = value % n;
    if (types.kind(count) == "int"){ ret int(result); }
    ret longint(result);
}

@Decorator.docstring("""
    One item of the array, each equally likely, from secure randomness. An
    empty array raises RangeError.

        pin = secrets.choice(arr("4", "7", "2", "9"));
""")
func choice(array items){
    if (items.is_empty()){ err(RangeError, "secrets.choice needs at least one item"); }
    ret items[int_below(items.len())];
}

@Decorator.docstring("""
    A random password of length characters, from the letters a-z and A-Z, the
    digits 0-9, and the symbols !@#$%^&*-_=+. Lengths from 1 to 1024; any other
    length raises RangeError.

        pw = secrets.password(16);   // for example "q7!Lx2@pV9#kTz4w"

    From length 4 up, the password has at least one lowercase letter, one
    uppercase letter, one digit, and one symbol. Characters are drawn at
    random and redrawn until all four classes appear, so every password that
    qualifies is equally likely. Shorter passwords, of 1 to 3 characters, are
    drawn with no class guaranteed, since they cannot hold all four.
""")
func password([int,longint] length){
    if (length < 1 or length > 1024){
        err(RangeError, "secrets.password needs a length from 1 to 1024, got " + string(length));
    }
    alphabet = _LOWER + _UPPER + _NUMBERS + _SYMBOLS;
    chosen = "";
    found = false;
    while (not found){
        chosen = _characters(alphabet, length);
        found = length < 4 or _has_all_classes(chosen);
    }
    ret chosen;
}

@Decorator.docstring("""
    Whether two strings are equal, checking every character whatever they hold,
    so the time taken does not reveal where they first differ. Use it to
    compare a secret, such as a token or an HMAC, with the one a user sent.

        out(secrets.same(token, sent));   // true or false
""")
func same(string a, string b) => hash.same(a, b);

@Decorator.private
func _draw(string name, [int,longint] count){
    if (count < 0 or count > 65536){ err(RangeError, name + " needs a count from 0 to 65536, got " + string(count)); }
    ret native.bytes(count);
}

// The bytes as one whole number, most significant first: [1, 0] is 256.
@Decorator.private
func _number(array data){
    value = bigint(0);
    for (digit, data){ value = value * 256 + digit; }
    ret value;
}

// Each byte as two lowercase hex digits.
@Decorator.private
func _hex(array data){
    parts = arr();
    for (digit, data){
        high = (digit - digit % 16) / 16;
        parts.add(_DIGITS[high]);
        parts.add(_DIGITS[digit % 16]);
    }
    ret strings.join(parts, "");
}

@Decorator.private
func _characters(string alphabet, [int,longint] length){
    parts = arr();
    size = alphabet.len();
    count = int(length);
    repeat count { parts.add(alphabet[int_below(size)]); }
    ret strings.join(parts, "");
}

@Decorator.private
func _has_all_classes(string text){
    ret _has_any(text, _LOWER) and _has_any(text, _UPPER) and _has_any(text, _NUMBERS) and _has_any(text, _SYMBOLS);
}

@Decorator.private
func _has_any(string text, string chars){
    for (i = 0, i < text.len(), i++){
        if (chars.contains(text[i])){ ret true; }
    }
    ret false;
}
