// std.Decorator: the decorator markers written above functions, families, and methods.
//
//     takepkg std.Decorator;
//     family Account{
//         @Decorator.private
//         func _audit(){ ... }
//     }
//
// This file is the list of markers: a name is only accepted as `@Decorator.NAME`
// if it is exported here, and its value names the marker. The interpreter applies
// them while compiling, so they are not called at runtime. Markers listed here but
// not yet applied by the interpreter report "not implemented yet".

// Documentation for the func, family, or method below it, shown by editors:
//     @Decorator.docstring("Adds two numbers.")
// A triple-quoted string may span lines; its indentation is removed.
fixed docstring (string) = "docstring";

// Callable only from methods of the family that declares it.
fixed private (string) = "private";

// Callable from the declaring family and from families inheriting from it.
fixed subclass (string) = "subclass";

// Planned: called on the family itself, without an instance.
fixed static (string) = "static";

// Planned: receives the family rather than an instance.
fixed class (string) = "class";

// Planned: several functions share a name, chosen by argument types.
fixed overload (string) = "overload";
